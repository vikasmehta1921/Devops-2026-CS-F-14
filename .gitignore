__pycache__/
*.py[cod]
*$py.class

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & IDE files
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

